{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/*.js": { "maxDuration": 10 }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(favicon.ico|favicon.svg|og-image.png)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/visa/:slug", "destination": "/index.html" },
    { "source": "/apply", "destination": "/index.html" },
    { "source": "/apply/:slug", "destination": "/index.html" },
    { "source": "/payment/:slug", "destination": "/index.html" },
    { "source": "/confirmation/:slug", "destination": "/index.html" },
    { "source": "/about", "destination": "/index.html" },
    { "source": "/press", "destination": "/index.html" },
    { "source": "/blog", "destination": "/index.html" },
    { "source": "/blog/:slug", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/terms", "destination": "/index.html" },
    { "source": "/refund", "destination": "/index.html" },
    { "source": "/disclaimer", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/dashboard", "destination": "/index.html" }
  ]
}
